{
  "name": "annex",
  "private": true,
  "type": "module",
  "description": "An office of Claude agents you can watch. Wings, leads, crews, and two modes.",
  "engines": {
    "node": ">=24.11.0"
  },
  "scripts": {
    "up": "node scripts/up.ts",
    "start": "node server/main.ts",
    "test": "node --test \"server/**/*.test.ts\" \"web/src/**/*.test.ts\"",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p web/tsconfig.json",
    "web:dev": "vite web",
    "web:build": "vite build web",
    "service:install": "node scripts/service.ts install",
    "service:remove": "node scripts/service.ts remove",
    "service:status": "node scripts/service.ts status",
    "open": "node scripts/open.ts"
  },
  "dependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-go": "^6.0.1",
    "@codemirror/lang-html": "^6.4.12",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/language": "^6.12.4",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.13",
    "@fontsource-variable/inter": "^5.3.0",
    "@lezer/highlight": "^1.2.5",
    "node-pty": "1.1.0",
    "smol-toml": "1.9.0"
  },
  "devDependencies": {
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@types/node": "^24.11.0",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/addon-web-links": "0.12.0",
    "@xterm/xterm": "6.0.0",
    "typescript": "^5.9.3",
    "vite": "^8.3.2"
  }
}
