{
  "name": "annex",
  "private": true,
  "type": "module",
  "description": "An office of Claude agents you can watch. Wings, leads, crews, and two modes.",
  "engines": {
    "node": ">=24.11.0"
  },
  "scripts": {
    "up": "node scripts/up.ts",
    "start": "node server/main.ts",
    "test": "node --test \"server/**/*.test.ts\" \"web/src/**/*.test.ts\"",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p web/tsconfig.json",
    "web:dev": "vite web",
    "web:build": "vite build web",
    "service:install": "node scripts/service.ts install",
    "service:remove": "node scripts/service.ts remove",
    "service:status": "node scripts/service.ts status",
    "open": "node scripts/open.ts"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "node-pty": "1.1.0",
    "smol-toml": "1.9.0"
  },
  "devDependencies": {
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@types/node": "^24.11.0",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/addon-web-links": "0.12.0",
    "@xterm/xterm": "6.0.0",
    "typescript": "^5.9.3",
    "vite": "^8.3.2"
  }
}
